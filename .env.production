# الإنتاج: الصفحة HTTPS والـ API HTTP فقط → الطلبات عبر نفس الدومين /api
# (يتطلّب إعداد nginx على em-online.online لتوجيه /api للباكند — انظر التعليق في apiConfig)
VITE_API_SAME_ORIGIN=true

# بعد تفعيل SSL على api.em-online.online يمكنك استخدام:
# VITE_API_SAME_ORIGIN=false
# VITE_API_BASE_URL=https://api.em-online.online
