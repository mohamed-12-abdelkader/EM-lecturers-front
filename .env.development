VITE_STREAM_REDIRECT_URL=http://localhost:5173/stream

# التطوير: الطلبات عبر Vite proxy (/) تُوجَّه تلقائياً إلى localhost:8000
VITE_API_BASE_URL=http://localhost:8000
VITE_API_PROXY_TARGET=http://localhost:8000
VITE_USE_VITE_PROXY=true

# النطاق الجذر لمنصات المدرسين (الإنتاج)
VITE_TENANT_ROOT_DOMAIN=emlectures.com

