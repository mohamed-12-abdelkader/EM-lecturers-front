VITE_STREAM_REDIRECT_URL=http://localhost:5173/stream

# تطوير: السيرفر المحلي فقط
# مهم: استخدم 127.0.0.1 وليس localhost — localhost قد يحلّ إلى ::1 ويصطدم بسيرفر Node آخر على :8000
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_USE_VITE_PROXY=true
VITE_FORCE_PROD_API=false

# لإجبار الاتصال بـ API البروداكشن أثناء التطوير (اختياري):
# VITE_FORCE_PROD_API=true
# VITE_API_BASE_URL=https://api.em-online.online/
# VITE_USE_VITE_PROXY=false

# النطاق الجذر لمنصات المدرسين (الإنتاج)
VITE_TENANT_ROOT_DOMAIN=emlectures.com
