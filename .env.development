VITE_STREAM_REDIRECT_URL=http://localhost:5173/stream

# localhost:3000 → اتصال مباشر بـ :8000 (يظهر في Network)
# *.localhost:3000 (منصات المدرس) → proxy تلقائي (CORS)
VITE_API_BASE_URL=http://localhost:8000
VITE_API_PROXY_TARGET=http://localhost:8000
VITE_USE_VITE_PROXY=false

# لو حابب proxy (الطلبات تظهر على :3000 والـ Vite يمرّرها لـ :8000):
# VITE_USE_VITE_PROXY=true

# النطاق الجذر لمنصات المدرسين (الإنتاج)
VITE_TENANT_ROOT_DOMAIN=emlectures.com
