VITE_STREAM_REDIRECT_URL=http://localhost:5173/stream

# عنوان الـ API — محلياً HTTP يعمل؛ في الإنتاج يُستخدم .env.production (HTTPS)
VITE_API_BASE_URL=http://api.em-online.online
VITE_API_PROXY_TARGET=http://api.em-online.online

# النطاق الجذر لمنصات المدرسين
VITE_TENANT_ROOT_DOMAIN=emlectures.com

# للباكند المحلي عبر proxy بدل الطلب المباشر (اختياري):
# VITE_USE_VITE_PROXY=true
# VITE_API_BASE_URL=http://127.0.0.1:8000
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
