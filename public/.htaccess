# نشر بدون تعطيل الجلسات النشطة — سياسات الكاش
<IfModule mod_headers.c>
  # لا تخزّن غلاف التطبيق أو ملف الإصدار أو سكربت الـ SW
  <FilesMatch "^(index\.html|sw\.js|version\.json|offline\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # أصول Vite المُجزّأة بالهاش داخل /assets — كاش طويل وثابت
  # (لا تشمل sw.js في الجذر)
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

# SPA fallback
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
